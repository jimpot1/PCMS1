APP_NAME=PCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,pcms.bcpsms1.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

SUPABASE_DB_HOST=your-supabase-db-host.pooler.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-supabase-db-password

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pcms
DB_USERNAME=root
DB_PASSWORD=

# Google Cloud Vision service-account key file (OCR asset tagging).
# Defaults to storage/app/private/google/vision-credentials.json — only set
# this if you place the credentials file somewhere else.
# GOOGLE_VISION_CREDENTIALS_PATH=/absolute/path/to/vision-credentials.json

# OpenAI Responses API settings for supplies anomaly explanations.
# Keep OPENAI_API_KEY in backend .env only. Never expose it to Vite/React.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT=20
